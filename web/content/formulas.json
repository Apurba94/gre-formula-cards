[{"id":"f01","tag":"Arithmetic","front":"Percent change","back":"(new − old) ÷ old × 100%","extra":"From 40 to 50 is a 25% increase; from 50 to 40 is a 20% decrease."},{"id":"f02","tag":"Arithmetic","front":"Successive percent changes: up a%, then down a%","back":"Net change is a loss of a^{2}/100 percent","extra":"Up 10% then down 10% gives 99% of the start."},{"id":"f03","tag":"Arithmetic","front":"Simple interest","back":"I = P × r × t","extra":"P principal, r yearly rate as a decimal, t years."},{"id":"f04","tag":"Arithmetic","front":"Compound interest","back":"A = P(1 + r/n)^{nt}","extra":"n compounding periods per year."},{"id":"f05","tag":"Arithmetic","front":"Average (arithmetic mean)","back":"sum of values ÷ number of values","extra":"Sum = mean × count is often the faster route."},{"id":"f06","tag":"Arithmetic","front":"Weighted average","back":"(w_{1}x_{1} + w_{2}x_{2} + …) ÷ (w_{1} + w_{2} + …)","extra":"The result lies closer to the value with more weight."},{"id":"f07","tag":"Arithmetic","front":"Rate, time and distance","back":"distance = rate × time","extra":"Average speed for a round trip is total distance ÷ total time, not the mean of the speeds."},{"id":"f08","tag":"Arithmetic","front":"Combined work rate","back":"1/t = 1/a + 1/b","extra":"If A takes a hours and B takes b hours, together they take t hours."},{"id":"f09","tag":"Number properties","front":"Number of factors of n = p^{a}q^{b}…","back":"(a + 1)(b + 1)…","extra":"72 = 2^{3} × 3^{2} has 4 × 3 = 12 factors."},{"id":"f10","tag":"Number properties","front":"Divisibility by 3 or 9","back":"The digit sum is divisible by 3 or 9","extra":"4,158: 4+1+5+8 = 18, so divisible by 9."},{"id":"f11","tag":"Number properties","front":"Divisibility by 4","back":"The last two digits form a multiple of 4","extra":"1,316: 16 is a multiple of 4."},{"id":"f12","tag":"Number properties","front":"gcd × lcm","back":"gcd(a, b) × lcm(a, b) = a × b","extra":"For positive integers a and b."},{"id":"f13","tag":"Number properties","front":"Is 0 even? Is 1 prime?","back":"0 is even. 1 is not prime; 2 is the only even prime.","extra":"A common GRE trap."},{"id":"f14","tag":"Number properties","front":"Sum of the integers 1 to n","back":"n(n + 1)/2","extra":"1 + 2 + … + 100 = 5,050."},{"id":"f15","tag":"Number properties","front":"Number of integers from a to b inclusive","back":"b − a + 1","extra":"From 15 to 40 there are 26 integers."},{"id":"f16","tag":"Algebra","front":"Difference of squares","back":"a^{2} − b^{2} = (a + b)(a − b)","extra":"99 × 101 = 100^{2} − 1 = 9,999."},{"id":"f17","tag":"Algebra","front":"(a + b)^{2}","back":"a^{2} + 2ab + b^{2}","extra":"Not a^{2} + b^{2}."},{"id":"f18","tag":"Algebra","front":"Quadratic formula","back":"x = (−b ± sqrt{b^{2} − 4ac}) / 2a","extra":"For ax^{2} + bx + c = 0."},{"id":"f19","tag":"Algebra","front":"Sum and product of the roots of ax^{2} + bx + c = 0","back":"sum = −b/a, product = c/a","extra":"Useful without solving."},{"id":"f20","tag":"Algebra","front":"x^{a} × x^{b}","back":"x^{a+b}","extra":"Same base: add exponents."},{"id":"f21","tag":"Algebra","front":"(x^{a})^{b}","back":"x^{ab}","extra":"Power of a power: multiply."},{"id":"f22","tag":"Algebra","front":"x^{−a}","back":"1/x^{a}","extra":"A negative exponent means a reciprocal."},{"id":"f23","tag":"Algebra","front":"x^{0}","back":"1, for any x ≠ 0","extra":""},{"id":"f24","tag":"Algebra","front":"Arithmetic sequence, nth term","back":"a_{n} = a_{1} + (n − 1)d","extra":"d is the common difference."},{"id":"f25","tag":"Algebra","front":"Geometric sequence, nth term","back":"a_{n} = a_{1} × r^{n−1}","extra":"r is the common ratio."},{"id":"f26","tag":"Geometry","front":"Sum of interior angles of an n-sided polygon","back":"(n − 2) × 180°","extra":"Hexagon: 720°."},{"id":"f27","tag":"Geometry","front":"Area of a triangle","back":"½ × base × height","extra":"The height is perpendicular to the base."},{"id":"f28","tag":"Geometry","front":"Pythagorean theorem","back":"a^{2} + b^{2} = c^{2}","extra":"Common triples: 3-4-5, 5-12-13, 8-15-17, 7-24-25."},{"id":"f29","tag":"Geometry","front":"45-45-90 triangle sides","back":"x : x : x sqrt{2}","extra":""},{"id":"f30","tag":"Geometry","front":"30-60-90 triangle sides","back":"x : x sqrt{3} : 2x","extra":"Shortest side is opposite 30°."},{"id":"f31","tag":"Geometry","front":"Area of a circle","back":"πr^{2}","extra":""},{"id":"f32","tag":"Geometry","front":"Circumference of a circle","back":"2πr","extra":""},{"id":"f33","tag":"Geometry","front":"Arc length for a central angle of θ degrees","back":"(θ/360) × 2πr","extra":"Sector area is (θ/360) × πr^{2}."},{"id":"f34","tag":"Geometry","front":"Triangle inequality","back":"Each side is less than the sum of the other two","extra":"And greater than their difference."},{"id":"f35","tag":"Geometry","front":"Volume of a cylinder","back":"πr^{2}h","extra":""},{"id":"f36","tag":"Geometry","front":"Volume and surface of a rectangular box","back":"V = lwh, surface = 2(lw + lh + wh)","extra":""},{"id":"f37","tag":"Geometry","front":"Diagonal of a rectangular box","back":"sqrt{l^{2} + w^{2} + h^{2}}","extra":""},{"id":"f38","tag":"Coordinate geometry","front":"Slope of the line through two points","back":"(y_{2} − y_{1}) / (x_{2} − x_{1})","extra":""},{"id":"f39","tag":"Coordinate geometry","front":"Slopes of perpendicular lines","back":"Their product is −1 (negative reciprocals)","extra":"Parallel lines have equal slopes."},{"id":"f40","tag":"Coordinate geometry","front":"Distance between two points","back":"sqrt{(x_{2} − x_{1})^{2} + (y_{2} − y_{1})^{2}}","extra":""},{"id":"f41","tag":"Coordinate geometry","front":"Midpoint","back":"((x_{1} + x_{2})/2, (y_{1} + y_{2})/2)","extra":""},{"id":"f42","tag":"Statistics","front":"Median","back":"The middle value when the data are in order; the mean of the two middle values if the count is even","extra":""},{"id":"f43","tag":"Statistics","front":"Range","back":"greatest value − least value","extra":""},{"id":"f44","tag":"Statistics","front":"Standard deviation, in words","back":"How far values typically lie from the mean","extra":"Adding a constant to every value leaves it unchanged; multiplying every value by k multiplies it by |k|."},{"id":"f45","tag":"Statistics","front":"Normal distribution: within 1 and 2 standard deviations of the mean","back":"About 68% and about 95%","extra":"About 99.7% within 3."},{"id":"f46","tag":"Statistics","front":"Interquartile range","back":"Q3 − Q1","extra":"The spread of the middle half of the data."},{"id":"f47","tag":"Counting and probability","front":"Permutations of n things taken k at a time","back":"n! / (n − k)!","extra":"Order matters."},{"id":"f48","tag":"Counting and probability","front":"Combinations of n things taken k at a time","back":"n! / (k!(n − k)!)","extra":"Order does not matter."},{"id":"f49","tag":"Counting and probability","front":"P(A or B)","back":"P(A) + P(B) − P(A and B)","extra":"If A and B cannot both happen, the last term is 0."},{"id":"f50","tag":"Counting and probability","front":"P(A and B) for independent events","back":"P(A) × P(B)","extra":""},{"id":"f51","tag":"Counting and probability","front":"P(not A)","back":"1 − P(A)","extra":"\"At least one\" problems are often easier as 1 − P(none)."},{"id":"f52","tag":"Sets","front":"Two overlapping groups","back":"Total = A + B − both + neither","extra":""}]